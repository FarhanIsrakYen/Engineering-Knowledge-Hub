EKH_APP_NAME=Engineering Knowledge Hub
EKH_ENVIRONMENT=development
EKH_DEBUG=false
EKH_LOG_LEVEL=INFO
EKH_DATABASE_URL=postgresql+asyncpg://ekh:ekh@localhost:5432/ekh
EKH_JWT_SECRET=replace-this-with-at-least-32-random-characters
EKH_ACCESS_TOKEN_EXPIRE_MINUTES=15
EKH_REFRESH_TOKEN_EXPIRE_DAYS=7
EKH_OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
EKH_OBJECT_STORAGE_ACCESS_KEY=minioadmin
EKH_OBJECT_STORAGE_SECRET_KEY=minioadmin
EKH_OBJECT_STORAGE_BUCKET=engineering-knowledge-hub
EKH_OBJECT_STORAGE_REGION=us-east-1
EKH_OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
EKH_DOCUMENT_MAX_UPLOAD_BYTES=26214400
EKH_REDIS_URL=redis://localhost:6379/0
EKH_DOCUMENT_CHUNK_SIZE=1200
EKH_DOCUMENT_CHUNK_OVERLAP=150
EKH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EKH_EMBEDDING_DIMENSIONS=384
EKH_EMBEDDING_CACHE_DIR=.cache/fastembed
EKH_QDRANT_URL=http://localhost:6333
EKH_QDRANT_COLLECTION=document_chunks_v1
EKH_QDRANT_AUTO_INITIALIZE=false

POSTGRES_DB=ekh
POSTGRES_USER=ekh
POSTGRES_PASSWORD=ekh
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
